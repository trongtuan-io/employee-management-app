<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/AppTitle"
            android:text="Quên mật khẩu" />

        <TextView
            style="@style/AppSubtitle"
            android:layout_marginTop="6dp"
            android:text="Làm theo 3 bước để đặt lại mật khẩu của bạn" />

        <LinearLayout
            style="@style/AppCard"
            android:layout_marginTop="24dp">

            <!-- Buoc 1: nhap email -->
            <LinearLayout
                android:id="@+id/step1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/AppLabel"
                    android:text="Bước 1 · Email đăng ký" />

                <EditText
                    android:id="@+id/etForgotEmail"
                    style="@style/AppInput"
                    android:layout_marginTop="8dp"
                    android:hint="Email phải có trong hệ thống"
                    android:inputType="textEmailAddress" />

                <Button
                    android:id="@+id/btnSendCode"
                    style="@style/AppButtonPrimary"
                    android:layout_marginTop="16dp"
                    android:text="Gửi mã xác nhận" />
            </LinearLayout>

            <!-- Buoc 2: nhap ma 6 so -->
            <LinearLayout
                android:id="@+id/step2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/AppLabel"
                    android:text="Bước 2 · Mã xác nhận" />

                <TextView
                    android:id="@+id/tvHint2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Nhập mã 6 số trong email"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etVerifyCode"
                    style="@style/AppInput"
                    android:layout_marginTop="8dp"
                    android:hint="Mã 6 số"
                    android:inputType="number"
                    android:maxLength="6" />

                <Button
                    android:id="@+id/btnVerifyCode"
                    style="@style/AppButtonPrimary"
                    android:layout_marginTop="16dp"
                    android:text="Xác nhận mã" />
            </LinearLayout>

            <!-- Buoc 3: mat khau moi -->
            <LinearLayout
                android:id="@+id/step3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/AppLabel"
                    android:text="Bước 3 · Mật khẩu mới" />

                <EditText
                    android:id="@+id/etForgotNewPass"
                    style="@style/AppInput"
                    android:layout_marginTop="8dp"
                    android:hint="Mật khẩu mới (ít nhất 6 ký tự)"
                    android:inputType="textPassword" />

                <EditText
                    android:id="@+id/etForgotConfirmPass"
                    style="@style/AppInput"
                    android:layout_marginTop="12dp"
                    android:hint="Xác nhận mật khẩu mới"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/btnResetPass"
                    style="@style/AppButtonPrimary"
                    android:layout_marginTop="16dp"
                    android:text="Đặt lại mật khẩu" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
