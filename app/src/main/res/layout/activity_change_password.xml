<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/AppTitle"
            android:text="Đổi mật khẩu" />

        <TextView
            style="@style/AppSubtitle"
            android:layout_marginTop="6dp"
            android:text="Dùng mật khẩu mạnh và không chia sẻ cho người khác" />

        <LinearLayout
            style="@style/AppCard"
            android:layout_marginTop="24dp">

            <TextView
                style="@style/AppLabel"
                android:text="Mật khẩu hiện tại" />

            <EditText
                android:id="@+id/etOldPassword"
                style="@style/AppInput"
                android:layout_marginTop="8dp"
                android:hint="Nhập mật khẩu hiện tại"
                android:inputType="textPassword" />

            <TextView
                style="@style/AppLabel"
                android:layout_marginTop="16dp"
                android:text="Mật khẩu mới" />

            <EditText
                android:id="@+id/etNewPassword"
                style="@style/AppInput"
                android:layout_marginTop="8dp"
                android:hint="Ít nhất 6 ký tự"
                android:inputType="textPassword" />

            <TextView
                style="@style/AppLabel"
                android:layout_marginTop="16dp"
                android:text="Xác nhận mật khẩu mới" />

            <EditText
                android:id="@+id/etConfirmPassword"
                style="@style/AppInput"
                android:layout_marginTop="8dp"
                android:hint="Nhập lại mật khẩu mới"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btnChangePassword"
                style="@style/AppButtonPrimary"
                android:layout_marginTop="24dp"
                android:text="Cập nhật mật khẩu" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
