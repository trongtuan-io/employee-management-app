<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvFaceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chấm công bằng khuôn mặt"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFaceStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/ivFacePreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="@color/text_secondary"
        android:contentDescription="Ảnh khuôn mặt vừa chụp"
        android:scaleType="centerCrop" />

    <Button
        android:id="@+id/btnCaptureFace"
        style="@style/AppButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mở camera chụp lại" />
</LinearLayout>
